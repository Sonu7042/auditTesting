generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String  @id @default(uuid())
  companyName String
  email       String?
  address     String?
  po_no       String?
  logoUrl     String? @db.Text
  contactName  String?
  contactPhone String?

  siteRequests    SiteSetupRequest[]
  users           User[]
  projects        Project[]
  auditProgrammes AuditProgramme[]

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String?  @unique
  username  String   @unique
  password  String
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  role      Role
  status    Boolean  @default(true)
  createdAt DateTime @default(now())

  // optional because auditor has no company
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  auditTypes UserAuditType[]

  auditAssignments     AuditAuditor[]
  corporateProjects    Project[]      @relation("CorporateManager")
  regionalProjects     Project[]      @relation("RegionalManager")
  siteInchargeProjects Project[]      @relation("SiteIncharge")
  siteUserProjects     Project[]      @relation("SiteUser")

  scheduledAuditors  ScheduledAuditor[]
  auditTimers        AuditTimer[]              @relation("AuditTimers")
  auditReports       AuditReport[]             @relation("AuditReports")
  assessmentProgress AuditAssessmentProgress[]

  createdWorkers              Worker[]                     @relation("CreatedWorkers")
  createdMachineries          Machinery[]                  @relation("CreatedMachineries")
  createdChemicals            Chemical[]                   @relation("CreatedChemicals")
  auditQuestionResponses      AuditQuestionResponse[]      @relation("AuditQuestionResponses")
  workforceNonCompliances     WorkforceNonCompliance[]     @relation("WorkforceNonCompliances")
  auditMachineryVerifications AuditMachineryVerification[] @relation("AuditMachineryVerifications")
  machineryNonCompliances     MachineryNonCompliance[]     @relation("MachineryNonCompliances")
  auditChemicalVerifications  AuditChemicalVerification[]  @relation("AuditChemicalVerifications")
  chemicalNonCompliances      ChemicalNonCompliance[]      @relation("ChemicalNonCompliances")
  notifications               Notification[]               @relation("CreatedNotifications")
  receivedNotifications       Notification[]               @relation("ReceivedNotifications")
  previousNcReviews           PreviousNcReview[]
  nextAuditUpdateSelections   NextAuditUpdateSelection[]
  submittedDocumentQuestions  ProjectChecklistQuestion[]   @relation("SubmittedDocumentQuestions")
  auditScheduleChanges        AuditScheduleHistory[]       @relation("AuditScheduleReschedulers")
  auditReminderDeliveries     AuditReminderDelivery[]
  auditEscalationDeliveries   AuditEscalationDelivery[]
  auditorQualification        AuditorQualification?
  auditorOnboarding           AuditorOnboarding?
  scopes                      UserScope[]
  auditorScores               AuditorScore[]
  clientAuditJobAssignments   ClientAuditJobAssignment[]
  createdClientAuditJobs      ClientAuditJob[]             @relation("ClientAuditJobCreator")
  clientAuditSessions         ClientAuditSession[]
}

enum Role {
  ADMIN
  AUDITOR
  CORPORATE_MANAGER
  SITE_INCHARGE
  SITE_USER
  REGIONAL_MANAGER
  ZONAL_MANAGER
}

model AuditType {
  id   String @id @default(uuid())
  name String @unique

  users UserAuditType[]
}

model UserAuditType {
  id String @id @default(uuid())

  userId      String
  auditTypeId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditType AuditType @relation(fields: [auditTypeId], references: [id])

  @@unique([userId, auditTypeId])
}

model Project {
  id          String    @id @default(uuid())
  projectName String
  siteAddress String
  poNumber    String?
  issueDate   DateTime?
  status      String    @default("Draft")
  dealerName  String?
  dealerPhone String?
  dealerEmail String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  corporateManagerId String?
  regionalManagerId  String?
  siteInchargeId     String?
  siteUserId         String?

  audits Audit[]

  corporateManager User? @relation("CorporateManager", fields: [corporateManagerId], references: [id])
  regionalManager  User? @relation("RegionalManager", fields: [regionalManagerId], references: [id])
  siteIncharge     User? @relation("SiteIncharge", fields: [siteInchargeId], references: [id])
  siteUser         User? @relation("SiteUser", fields: [siteUserId], references: [id])

  createdAt DateTime @default(now())

  schedules                   AuditSchedule[]
  auditTimers                 AuditTimer[]
  auditReports                AuditReport[]
  assessmentProgress          AuditAssessmentProgress[]
  workers                     Worker[]
  machineries                 Machinery[]
  chemicals                   Chemical[]
  workforceNonCompliances     WorkforceNonCompliance[]
  auditMachineryVerifications AuditMachineryVerification[]
  machineryNonCompliances     MachineryNonCompliance[]
  auditChemicalVerifications  AuditChemicalVerification[]
  chemicalNonCompliances      ChemicalNonCompliance[]
  projectChecklistSections    ProjectChecklistSection[]
  dealerLocation              DealerLocation?
}

model AuditProgramme {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  code          String
  programmeType String
  financialYear String
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations         DealerLocation[]
  checklistVersions ClientChecklistVersion[]

  @@unique([companyId, code])
  @@index([companyId, programmeType, status])
}

model DealerLocation {
  id                   String   @id @default(uuid())
  programmeId          String
  projectId            String?  @unique
  zone                 String
  regionalOffice       String
  dealerName           String
  dealerCode           String
  locationName         String
  locationCode         String
  address              String
  city                 String?
  district             String?
  state                String?
  latitude             Float
  longitude            Float
  geofenceRadiusM      Int      @default(200)
  contactName          String
  contactPhone         String
  contactEmail         String
  electricalSupplyType String?
  sapCode              String?
  parentCode           String?
  madbCode             String?
  category             String?
  cityClassification   String?
  retailFormat         String?
  profile              Json?
  status               String   @default("SETUP")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  programme          AuditProgramme              @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  project            Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  facilities         Facility[]
  sharedMappings     SharedFacilityMapping[]
  checklistSnapshots LocationChecklistSnapshot[]
  clientAuditJobs    ClientAuditJob[]

  @@unique([programmeId, locationCode])
  @@index([programmeId, zone, regionalOffice])
  @@index([dealerCode])
}

model Facility {
  id            String   @id @default(uuid())
  locationId    String
  facilityType  String
  displayName   String?
  tier          String?
  ciLevel       String?
  format        String?
  workshopType  String?
  stockyardType String?
  sellsPv       Boolean  @default(false)
  sellsBev      Boolean  @default(false)
  sellsCv       Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location DealerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, facilityType])
  @@index([facilityType, ciLevel])
}

model SharedFacilityMapping {
  id           String   @id @default(uuid())
  locationId   String
  facilityCode String
  description  String?
  arrangement  String   @default("SHARED")
  usedBy       Json
  quantity     Int      @default(1)
  auditAtSite  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location DealerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, facilityCode])
}

model ClientChecklistVersion {
  id            String    @id @default(uuid())
  programmeId   String
  name          String
  version       String
  status        String    @default("DRAFT")
  effectiveDate DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  programme AuditProgramme              @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  items     ClientChecklistItem[]
  snapshots LocationChecklistSnapshot[]

  @@unique([programmeId, version])
  @@index([programmeId, status])
}

model ClientChecklistItem {
  id                String   @id @default(uuid())
  versionId         String
  moduleCode        String
  sectionName       String
  questionCode      String
  questionText      String
  expectedCondition String?
  discipline        String   @default("INFRASTRUCTURE")
  responseType      String   @default("COMPLIANCE")
  severityOnFail    String   @default("MEDIUM")
  mahindraPriority  String   @default("IMPORTANT")
  weight            Float    @default(1)
  evidenceRequired  Boolean  @default(false)
  minimumEvidence   Int      @default(0)
  naAllowed         Boolean  @default(true)
  naReasonRequired  Boolean  @default(true)
  measurementUnit   String?
  minimumValue      Float?
  maximumValue      Float?
  regulationRef     String?
  applicabilityRule Json?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  version ClientChecklistVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, questionCode])
  @@index([versionId, moduleCode, sortOrder])
}

model LocationChecklistSnapshot {
  id               String   @id @default(uuid())
  locationId       String
  versionId        String
  checklistName    String
  checklistVersion String
  itemCount        Int
  configuration    Json
  generatedAt      DateTime @default(now())

  location  DealerLocation                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  version   ClientChecklistVersion          @relation(fields: [versionId], references: [id], onDelete: Restrict)
  items     LocationChecklistSnapshotItem[]
  auditJobs ClientAuditJob[]

  @@unique([locationId, versionId])
  @@index([locationId, generatedAt])
}

model LocationChecklistSnapshotItem {
  id           String @id @default(uuid())
  snapshotId   String
  sourceItemId String
  moduleCode   String
  sectionName  String
  questionCode String
  sortOrder    Int
  itemData     Json

  snapshot          LocationChecklistSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  responses         ClientAuditQuestionResponse[]
  reportCorrections ClientAuditReportCorrection[]

  @@unique([snapshotId, sourceItemId])
  @@index([snapshotId, moduleCode, sortOrder])
}

model AuditorQualification {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  skills                 Json
  supportedRegions       Json
  calibrationScore       Float
  backgroundVerified     Boolean   @default(false)
  platformCertified      Boolean   @default(false)
  shadowAuditsCompleted  Int       @default(0)
  authorityLetterNumber  String?
  certificationExpiresAt DateTime?
  status                 String    @default("INACTIVE")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientAuditJob {
  id               String    @id @default(uuid())
  locationId       String
  snapshotId       String
  createdById      String
  auditCycle       String
  auditType        String    @default("PERIODIC")
  scheduledStart   DateTime
  scheduledEnd     DateTime
  requiredSkills   Json
  readiness        Json
  status           String    @default("SCHEDULED")
  notes            String?
  dealerNotifiedAt DateTime?
  facilityType     String?
  includesShared   Boolean   @default(true)
  isDemo           Boolean   @default(false)
  visitGroup       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  notices     ClientAuditNotice[]
  location    DealerLocation             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  snapshot    LocationChecklistSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  createdBy   User                       @relation("ClientAuditJobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments ClientAuditJobAssignment[]
  sessions    ClientAuditSession[]
  report      ClientAuditReport?

  @@index([locationId, scheduledStart])
  @@index([status, scheduledStart])
}

model ClientAuditReport {
  id            String    @id @default(uuid())
  jobId         String    @unique
  reportNumber  String    @unique
  status        String    @default("DRAFT")
  revision      Int       @default(1)
  reviewRemarks String?
  approvedById  String?
  approvedAt    DateTime?
  publishedAt   DateTime?
  qcScore       Float?
  scoreSnapshot Json?
  qcBreakdown   Json?
  anomalies     Json?
  signedByName        String?
  signedByDesignation String?
  signedAt            DateTime?
  signatureUrl        String?   @db.Text
  debriefNotes        String?
  generatedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  job         ClientAuditJob                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  history     ClientAuditReportHistory[]
  corrections ClientAuditReportCorrection[]
}

// A frozen copy of an issued report version, kept when a revision is opened so every revision can still be downloaded.
model ClientAuditReportRevision {
  id         String   @id @default(uuid())
  reportId   String
  revision   Int
  issuedAt   DateTime?
  reason     String?
  openedById String?
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([reportId, revision])
}

model ClientAuditReportHistory {
  id         String            @id @default(uuid())
  reportId   String
  action     String
  fromStatus String?
  toStatus   String
  remarks    String?
  actorId    String
  createdAt  DateTime          @default(now())
  report     ClientAuditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model ClientAuditReportCorrection {
  id                        String    @id @default(uuid())
  reportId                  String
  snapshotItemId            String?
  category                  String
  priority                  String    @default("MEDIUM")
  instruction               String
  dueDate                   DateTime?
  status                    String    @default("OPEN")
  resolution                String?
  correctedResult           String?
  correctedObservation      String?
  correctedMeasurementValue Float?
  correctedNaReason         String?
  raisedById                String
  submittedById             String?
  submittedAt               DateTime?
  reviewedById              String?
  reviewedAt                DateTime?
  reviewRemarks             String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  report       ClientAuditReport                     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  snapshotItem LocationChecklistSnapshotItem?        @relation(fields: [snapshotItemId], references: [id], onDelete: Restrict)
  evidence     ClientAuditReportCorrectionEvidence[]

  @@index([reportId, status])
  @@index([snapshotItemId])
}

model ClientAuditReportCorrectionEvidence {
  id           String   @id @default(uuid())
  correctionId String
  imageUrl     String
  publicId     String?
  imageName    String?
  mimeType     String?
  fileHash     String
  uploadedById String
  createdAt    DateTime @default(now())

  correction ClientAuditReportCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)

  @@index([correctionId, createdAt])
}

model ClientAuditSession {
  id                      String    @id @default(uuid())
  jobId                   String
  auditorId               String
  status                  String    @default("IN_PROGRESS")
  deviceId                String
  checkInLatitude         Float
  checkInLongitude        Float
  gpsAccuracy             Float
  distanceFromSiteM       Float
  checkInEvidenceUrl      String
  checkInEvidencePublicId String?
  checkInEvidenceName     String?
  checkInEvidenceMimeType String?
  evidenceHash            String
  checkedInAt             DateTime  @default(now())
  endedAt                 DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  job        ClientAuditJob                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  auditor    User                          @relation(fields: [auditorId], references: [id], onDelete: Restrict)
  events     ClientAuditSessionEvent[]
  responses  ClientAuditQuestionResponse[]
  completion ClientAuditCompletion?

  @@unique([jobId, auditorId])
  @@index([auditorId, status])
  @@index([jobId, status])
}

model ClientAuditCompletion {
  id                  String   @id @default(uuid())
  sessionId           String   @unique
  finalRemarks        String
  declarationAccepted Boolean
  signatureUrl        String
  signatureHash       String
  summary             Json
  completedAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  session ClientAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ClientAuditQuestionResponse {
  id                String    @id @default(uuid())
  sessionId         String
  snapshotItemId    String
  responseStatus    String    @default("DRAFT")
  answer            String?
  result            String?
  observation       String?
  measurementValue  Float?
  naReason          String?
  recommendation    String?
  responsiblePerson String?
  targetDate        DateTime?
  closedOnSpot      Boolean   @default(false)
  correctionComment String?
  revision          Int       @default(1)
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session       ClientAuditSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  snapshotItem  LocationChecklistSnapshotItem @relation(fields: [snapshotItemId], references: [id], onDelete: Restrict)
  evidence      ClientAuditResponseEvidence[]
  revisions     ClientAuditResponseRevision[]
  nonCompliance ClientAuditNonCompliance?

  @@unique([sessionId, snapshotItemId])
  @@index([sessionId, responseStatus])
  @@index([snapshotItemId])
}

model ClientAuditNonCompliance {
  id                String    @id @default(uuid())
  ncNumber          String    @unique
  responseId        String    @unique
  jobId             String
  sessionId         String
  snapshotItemId    String
  status            String    @default("OPEN")
  severity          String
  priority          String
  observation       String
  recommendation    String?
  rootCause         String?
  correctiveAction  String?
  preventiveAction  String?
  responsiblePerson String?
  targetDate        DateTime?
  capaSubmittedById String?
  capaSubmittedAt   DateTime?
  auditorRemarks    String?
  reviewedById      String?
  reviewedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  response ClientAuditQuestionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  evidence ClientAuditNcEvidence[]
  history  ClientAuditNcHistory[]

  @@index([jobId, status])
  @@index([sessionId])
  @@index([status, targetDate])
}

model ClientAuditNcEvidence {
  id           String   @id @default(uuid())
  ncId         String
  evidenceType String   @default("CAPA")
  imageUrl     String
  publicId     String?
  imageName    String?
  mimeType     String?
  fileHash     String
  uploadedById String
  createdAt    DateTime @default(now())

  nonCompliance ClientAuditNonCompliance @relation(fields: [ncId], references: [id], onDelete: Cascade)

  @@index([ncId, createdAt])
}

model ClientAuditNcHistory {
  id         String   @id @default(uuid())
  ncId       String
  action     String
  fromStatus String?
  toStatus   String
  remarks    String?
  actorId    String
  createdAt  DateTime @default(now())

  nonCompliance ClientAuditNonCompliance @relation(fields: [ncId], references: [id], onDelete: Cascade)

  @@index([ncId, createdAt])
}

model ClientAuditResponseEvidence {
  id         String   @id @default(uuid())
  responseId String
  kind       String   @default("ISSUE")
  imageUrl   String
  publicId   String?
  imageName  String?
  mimeType   String?
  fileHash   String
  createdAt  DateTime @default(now())

  response ClientAuditQuestionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId, createdAt])
}

model ClientAuditResponseRevision {
  id               String   @id @default(uuid())
  responseId       String
  revisionNumber   Int
  previousResponse Json
  changedAt        DateTime @default(now())

  response ClientAuditQuestionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, revisionNumber])
}

model ClientAuditSessionEvent {
  id        String   @id @default(uuid())
  sessionId String
  eventType String
  eventData Json?
  createdAt DateTime @default(now())

  session ClientAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ClientAuditJobAssignment {
  id             String    @id @default(uuid())
  jobId          String
  auditorId      String
  assignedSkills Json
  assignmentRole String    @default("MEMBER")
  track          String    @default("ALL")
  status         String    @default("ASSIGNED")
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  job     ClientAuditJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  auditor User           @relation(fields: [auditorId], references: [id], onDelete: Restrict)

  @@unique([jobId, auditorId])
  @@index([auditorId, status])
}

model Audit {
  id              String  @id @default(uuid())
  auditType       String
  cycleNumber     Int     @default(1)
  previousAuditId String?
  previousAudit   Audit?  @relation("AuditCycles", fields: [previousAuditId], references: [id], onDelete: SetNull)
  nextAudits      Audit[] @relation("AuditCycles")

  checklistType     String
  checklistTemplate ChecklistTemplate @relation(fields: [checklistType], references: [id])

  frequency      String
  numberOfAudits Int

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  auditors AuditAuditor[]

  schedules                   AuditSchedule[]
  auditTimers                 AuditTimer[]
  auditReports                AuditReport[]
  assessmentProgress          AuditAssessmentProgress[]
  auditQuestionResponses      AuditQuestionResponse[]
  previousNcReviews           PreviousNcReview[]           @relation("CurrentAuditPreviousNcReviews")
  sourceNcReviews             PreviousNcReview[]           @relation("SourceAuditPreviousNcReviews")
  nextAuditUpdateSelections   NextAuditUpdateSelection[]
  workforceNonCompliances     WorkforceNonCompliance[]
  machineryNonCompliances     MachineryNonCompliance[]
  chemicalNonCompliances      ChemicalNonCompliance[]
  auditMachineryVerifications AuditMachineryVerification[]
  auditChemicalVerifications  AuditChemicalVerification[]
}

model AuditAuditor {
  id String @id @default(uuid())

  auditId    String
  userId     String
  isNotified Boolean @default(false)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditSchedule {
  id String @id @default(uuid())

  projectId String
  auditId   String   @unique
  date      DateTime

  project Project @relation(fields: [projectId], references: [id])
  audit   Audit   @relation(fields: [auditId], references: [id])

  auditors             ScheduledAuditor[]
  history              AuditScheduleHistory[]
  reminderDeliveries   AuditReminderDelivery[]
  escalationDeliveries AuditEscalationDelivery[]

  createdAt DateTime @default(now())
}

model AuditReminderDelivery {
  id            String    @id @default(uuid())
  scheduleId    String
  auditorId     String
  auditDate     DateTime
  daysBefore    Int
  status        String    @default("PENDING")
  attempts      Int       @default(1)
  lastAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  schedule AuditSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  auditor  User          @relation(fields: [auditorId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, auditorId, auditDate, daysBefore])
  @@index([status, lastAttemptAt])
}

model AuditEscalationDelivery {
  id                 String    @id @default(uuid())
  scheduleId         String
  recipientId        String
  scheduledDate      DateTime
  overdueDays        Int
  status             String    @default("PENDING")
  attempts           Int       @default(1)
  lastAttemptAt      DateTime  @default(now())
  notificationSentAt DateTime?
  emailSentAt        DateTime?
  error              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  schedule  AuditSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  recipient User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, recipientId, scheduledDate, overdueDays])
  @@index([status, lastAttemptAt])
}

model AuditScheduleHistory {
  id              String        @id @default(uuid())
  scheduleId      String
  previousDate    DateTime
  newDate         DateTime
  reason          String
  rescheduledById String
  schedule        AuditSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  rescheduledBy   User          @relation("AuditScheduleReschedulers", fields: [rescheduledById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([scheduleId, createdAt])
}

model AuditTimer {
  id String @id @default(uuid())

  projectId String
  auditId   String
  auditorId String
  elapsedMs Int       @default(0)
  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
