  decisionRemarks String?
  previousValues  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([locationId, status])
  @@index([requestedById])
}

// After a report is issued, the dealer can ask for a clarification or request a change. Back-Admin or the lead auditor
// answers; an accepted change opens a new revision of the report, and issuing that revision marks the change done.
model ReportClarification {
  id                 String    @id @default(uuid())
  reportId           String
  revisionRaised     Int       @default(1)
  kind               String
  snapshotItemId     String?
  message            String
  raisedById         String
  status             String    @default("OPEN")
  response           String?
  respondedById      String?
  respondedAt        DateTime?
  resolvedInRevision Int?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([reportId, status])
}
