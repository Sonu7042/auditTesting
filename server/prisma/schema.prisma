// A site user or auditor asks for a correction to a site's master data (contact, address, GPS, supply type).
// Master data changes only after Back-Admin approves; the previous values are kept on the request for the audit trail.
model SiteChangeRequest {
  id              String    @id @default(uuid())
  locationId      String
  requestedById   String
  changes         Json
  reason          String
  photoUrl        String?   @db.Text
  status          String    @default("PENDING")
