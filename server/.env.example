DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=8000
CLIENT_URL=http://localhost:5173

# SMTP/Gmail app-password credentials used for dealer email delivery
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password

# Comma-separated days before an audit when assigned auditors receive email.
AUDIT_REMINDER_DAYS=3,1,0
# The server checks for due reminders hourly (minimum: 5 minutes).
AUDIT_REMINDER_INTERVAL_MINUTES=60

# Escalate incomplete audits after these overdue-day milestones.
AUDIT_ESCALATION_DAYS=1,3,7
AUDIT_ESCALATION_INTERVAL_MINUTES=60

CLOUDINARY_CLOUD_NAME=your-cloud-name 
CLOUDINARY_API_KEY=your-api-key              
CLOUDINARY_API_SECRET=your-api-secret                  



    


